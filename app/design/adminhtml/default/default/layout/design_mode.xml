<layout>
    <!--
        Added to the same handle that loads the editor, and behind the same flag,
        so the script is only served on the pages that can open the editor.
    -->
    <editor>
        <reference name="head">
            <action method="addItem"><type>js</type><name>mage/adminhtml/wysiwyg/design-mode.js</name><params/><condition>can_load_wysiwyg</condition></action>
            <action method="addItem"><type>js_css</type><name>mage/adminhtml/wysiwyg/design-mode.css</name><params/><condition>can_load_wysiwyg</condition></action>
        </reference>
        <!--
            The preview settings travel on a global instead of the editor config:
            the block renders nothing outside the CMS page and block editors.
        -->
        <reference name="before_body_end">
            <block type="designmode/adminhtml_preview" name="designmode.preview"/>
        </reference>
    </editor>
</layout>
